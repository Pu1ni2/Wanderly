# --- W&B (sponsor) ---
# Powers BOTH W&B Inference (planning models) and W&B Weave (tracing + evals).
# Get it from https://wandb.ai/authorize
WANDB_API_KEY=
# Optional, "<team>/wanderly" for project-scoped usage tracking
WANDB_PROJECT=

# --- OpenAI ---
# Required for voice (Realtime), TTS, and Place Vision.
OPENAI_API_KEY=sk-...

# --- Specialist APIs (optional — every specialist ships a mock fallback) ---
UNSPLASH_ACCESS_KEY=
GOOGLE_PLACES_API_KEY=
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# No key required for these, listed for clarity:
# Weather  -> Open-Meteo
# Currency -> Frankfurter
